# --- SQLite Runtime Databases & Snapshots (Privacy Guarantee) ---
# CRITICAL: Ensures company accounting databases and local snapshots are NEVER committed
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.db.bak
*.bak
audit_assistant_data.db
*.local.db

# --- Certificates, Keys & Secrets Protection ---
*.pfx
*.p12
*.key
*.pem
*.cer
*.crt

# --- Operating System & Temporary Files ---
[Tt]emp/
[Tt]mp/
*.tmp
*.swp
*~
