<Application x:Class="TallyAuditAssistant.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TallyAuditAssistant.App">
    <Application.Resources>
        <!-- Windows 11 Fluent Clean Auditor Color Palette -->
        <Color x:Key="PrimaryBrandColor">#0F766E</Color>
        <Color x:Key="PrimaryBrandHoverColor">#115E59</Color>
        <Color x:Key="SurfaceBackground">#0F172A</Color>
        <Color x:Key="CardBackground">#1E293B</Color>
        <Color x:Key="BorderColor">#334155</Color>
        <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
        <Color x:Key="TextMutedColor">#94A3B8</Color>
        
        <SolidColorBrush x:Key="PrimaryBrandBrush" Color="{StaticResource PrimaryBrandColor}" />
        <SolidColorBrush x:Key="PrimaryBrandHoverBrush" Color="{StaticResource PrimaryBrandHoverColor}" />
        <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="{StaticResource SurfaceBackground}" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackground}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

        <!-- Global Control Styles -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrandBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Application.Resources>
</Application>
