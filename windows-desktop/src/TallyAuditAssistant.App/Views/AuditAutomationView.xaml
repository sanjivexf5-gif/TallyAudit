<UserControl x:Class="TallyAuditAssistant.App.Views.AuditAutomationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <TextBlock Text="⚡ Smart Audit Automation" FontSize="28" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Automate the repetitive audit workflow from TallyPrime connection through synchronization, analysis and report preparation."
                       Foreground="#94A3B8" FontSize="13" Margin="0,6,0,18" TextWrapping="Wrap"/>

            <Border Padding="18" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ACTIVE COMPANY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding CompanyName}" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                        <TextBlock Text="TallyPrime remains read-only. All audit results and documents are stored locally."
                                   FontSize="11" Foreground="#10B981" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Padding="10,6" Background="#0F172A" CornerRadius="6" VerticalAlignment="Center">
                        <TextBlock Text="AUTOMATED WORKFLOW" Foreground="#38BDF8" FontWeight="Bold" FontSize="11"/>
                    </Border>
                </Grid>
            </Border>

            <Border Padding="18" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="ONE-CLICK AUDIT PIPELINE" FontSize="15" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="1. Auto-connect TallyPrime  →  2. Resolve company &amp; period  →  3. Incremental sync  →  4. Run all enabled audit rules &amp; reconciliations  →  5. Generate report pack"
                               FontSize="12" Foreground="#94A3B8" Margin="0,5,0,16" TextWrapping="Wrap"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Margin="0,0,6,0" Padding="10" Background="#0F172A" CornerRadius="6">
                            <StackPanel><TextBlock Text="① CONNECT" Foreground="#38BDF8" FontWeight="Bold"/><TextBlock Text="Automatic discovery" Foreground="#94A3B8" FontSize="10"/></StackPanel>
                        </Border>
                        <Border Grid.Column="1" Margin="2,0,4,0" Padding="10" Background="#0F172A" CornerRadius="6">
                            <StackPanel><TextBlock Text="② COMPANY" Foreground="#38BDF8" FontWeight="Bold"/><TextBlock Text="Auto-select active" Foreground="#94A3B8" FontSize="10"/></StackPanel>
                        </Border>
                        <Border Grid.Column="2" Margin="2,0,4,0" Padding="10" Background="#0F172A" CornerRadius="6">
                            <StackPanel><TextBlock Text="③ SYNC" Foreground="#38BDF8" FontWeight="Bold"/><TextBlock Text="Adaptive large-data sync" Foreground="#94A3B8" FontSize="10"/></StackPanel>
                        </Border>
                        <Border Grid.Column="3" Margin="2,0,4,0" Padding="10" Background="#0F172A" CornerRadius="6">
                            <StackPanel><TextBlock Text="④ AUDIT" Foreground="#38BDF8" FontWeight="Bold"/><TextBlock Text="All enabled rules" Foreground="#94A3B8" FontSize="10"/></StackPanel>
                        </Border>
                        <Border Grid.Column="4" Margin="2,0,0,0" Padding="10" Background="#0F172A" CornerRadius="6">
                            <StackPanel><TextBlock Text="⑤ REPORT" Foreground="#38BDF8" FontWeight="Bold"/><TextBlock Text="Automatic pack" Foreground="#94A3B8" FontSize="10"/></StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="⚡ START AUTOMATED AUDIT" Command="{Binding StartAutomatedAuditCommand}"
                                IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
                                Background="#0D9488" Foreground="White" FontWeight="Bold" Padding="18,11" Margin="0,0,10,0"/>
                        <Button Content="⏹ STOP SAFELY" Command="{Binding CancelCommand}"
                                IsEnabled="{Binding IsRunning}" Background="#DC2626" Foreground="White" FontWeight="Bold" Padding="18,11"/>
                    </StackPanel>

                    <CheckBox Content="Automatically generate the audit report pack when the workflow completes"
                              IsChecked="{Binding GenerateReport}" Foreground="White" Margin="0,14,0,4"/>
                    <CheckBox Content="Open Findings automatically after successful completion"
                              IsChecked="{Binding GoToFindingsWhenComplete}" Foreground="White"/>
                </StackPanel>
            </Border>

            <Border Padding="18" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding StageTitle}" FontSize="13" FontWeight="Bold" Foreground="#38BDF8"/>
                        <TextBlock Text="{Binding ProgressPercentage, StringFormat={}{0:F0}%}" HorizontalAlignment="Right"
                                   FontSize="13" FontWeight="Bold" Foreground="#10B981"/>
                    </Grid>
                    <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="12" Margin="0,8,0,10"
                                 Background="#0F172A" Foreground="{StaticResource PrimaryBrandBrush}"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="White" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="0,0,6,0" Padding="16" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8">
                    <StackPanel><TextBlock Text="SYNCHRONIZED" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                        <TextBlock Text="{Binding RecordsSynchronized, StringFormat={}{0:N0}}" Foreground="White" FontSize="24" FontWeight="Bold"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Margin="2,0,4,0" Padding="16" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8">
                    <StackPanel><TextBlock Text="FINDINGS" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                        <TextBlock Text="{Binding Findings, StringFormat={}{0:N0}}" Foreground="#F59E0B" FontSize="24" FontWeight="Bold"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Margin="4,0,0,0" Padding="16" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8">
                    <StackPanel><TextBlock Text="ELAPSED" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                        <TextBlock Text="{Binding ElapsedTime}" Foreground="White" FontSize="24" FontWeight="Bold"/></StackPanel>
                </Border>
            </Grid>

            <Border Margin="0,16,0,0" Padding="14" Background="#102A2A" BorderBrush="#0D9488" BorderThickness="1" CornerRadius="8">
                <TextBlock Text="Automation is designed to save auditor time by removing repetitive navigation and data-preparation steps. It does not post, edit, delete or otherwise modify TallyPrime data."
                           Foreground="#A7F3D0" TextWrapping="Wrap" FontSize="12"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
