<UserControl x:Class="TallyAuditAssistant.App.Views.AuditFinalizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <!-- Finalization owns this card style so the view does not depend on a
             resource that is not defined in the application-level dictionary. -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Audit Finalization &amp; Sign-off" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding ActiveCompanyName}" Margin="0,4,0,0" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
            <TextBlock Text="{Binding FinancialYear, StringFormat=Financial Year: {0}}" Margin="0,2,0,0" Foreground="{StaticResource TextMutedBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="14"><StackPanel><TextBlock Text="STATUS" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding LifecycleStatus}" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="4,0,8,0" Padding="14"><StackPanel><TextBlock Text="CHECKLIST" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding ChecklistCompletion, StringFormat={}{0}%}" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="4,0,8,0" Padding="14"><StackPanel><TextBlock Text="HIGH RISK PENDING" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding PendingHighRisk}" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
            <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="4,0,8,0" Padding="14"><StackPanel><TextBlock Text="OPEN ITEMS" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding OpenItems}" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Margin="4,0,0,0" Padding="14"><StackPanel><TextBlock Text="EVIDENCE" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding VerifiedEvidence, StringFormat={}{0} verified}" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Finalization Readiness" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding ReadinessIssues}">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,3" Foreground="{StaticResource TextPrimaryBrush}"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Auditor Conclusion" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Conclusion status" Margin="0,12,0,4" Foreground="{StaticResource TextMutedBrush}"/>
                        <ComboBox ItemsSource="{Binding ConclusionStatuses}" SelectedItem="{Binding ConclusionStatus}" MinWidth="260"/>
                        <TextBlock Text="Conclusion / basis" Margin="0,12,0,4" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Text="{Binding ConclusionText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100"/>
                        <TextBlock Text="Reviewer name" Margin="0,12,0,4" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Text="{Binding ReviewerName, UpdateSourceTrigger=PropertyChanged}" Width="320" HorizontalAlignment="Left"/>
                        <TextBlock Text="Reviewer comments" Margin="0,12,0,4" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Text="{Binding ReviewerComments, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Save Conclusion" Command="{Binding SaveConclusionCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="Mark Ready for Finalization" Command="{Binding MarkReadyForFinalizationCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="Finalize Audit" Command="{Binding FinalizeAuditCommand}" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanFinalize}" Margin="0,0,8,0"/>
                            <Button Content="Generate Summary" Command="{Binding GenerateFinalizationSummaryCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="14" Background="#142033" CornerRadius="8" Margin="0,0,0,16">
                    <TextBlock Text="Read-only policy: finalization records, notes and generated documents are stored locally. TallyPrime data is never modified by this workflow." TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                </Border>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,18"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
