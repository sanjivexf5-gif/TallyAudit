<UserControl x:Class="TallyAuditAssistant.App.Views.AuditMaterialityView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
 <UserControl.Resources>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,12,12"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0F172A"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="Padding" Value="7,5"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="#0F172A"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/></Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel>
   <TextBlock Text="Materiality &amp; Sampling" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
   <TextBlock Text="{Binding CompanyName}" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
   <TextBlock Text="{Binding FinancialYear}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16"/>
   <UniformGrid Columns="3">
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="OVERALL MATERIALITY" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding OverallMateriality, StringFormat={}{0:N2}}" FontSize="24" FontWeight="Bold" Foreground="White"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PERFORMANCE MATERIALITY" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding PerformanceMateriality, StringFormat={}{0:N2}}" FontSize="24" FontWeight="Bold" Foreground="White"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="SUGGESTED SAMPLE" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding SuggestedSampleSize}" FontSize="24" FontWeight="Bold" Foreground="White"/></StackPanel></Border>
   </UniformGrid>
   <Border Style="{StaticResource Card}">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="260"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
     <TextBlock Grid.Row="0" Grid.Column="0" Text="Benchmark amount" Foreground="{StaticResource TextMutedBrush}" Margin="0,8"/>
     <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding BenchmarkAmount, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,12,4"/>
     <TextBlock Grid.Row="1" Grid.Column="0" Text="Benchmark percentage" Foreground="{StaticResource TextMutedBrush}" Margin="0,8"/>
     <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BenchmarkPercentage, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,12,4"/>
     <TextBlock Grid.Row="2" Grid.Column="0" Text="Population vouchers" Foreground="{StaticResource TextMutedBrush}" Margin="0,8"/>
     <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PopulationCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,12,4"/>
     <TextBlock Grid.Row="3" Grid.Column="0" Text="Population amount" Foreground="{StaticResource TextMutedBrush}" Margin="0,8"/>
     <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PopulationAmount, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,12,4"/>
     <TextBlock Grid.Row="4" Grid.Column="0" Text="Sampling method" Foreground="{StaticResource TextMutedBrush}" Margin="0,8"/>
     <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding SamplingMethods}" SelectedItem="{Binding SamplingMethod}" Margin="0,4,12,4"/>
     <TextBlock Grid.Row="0" Grid.Column="2" Text="Trivial threshold" Foreground="{StaticResource TextMutedBrush}" Margin="0,8"/>
     <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding TrivialThreshold, StringFormat={}{0:N2}}" Foreground="White" Margin="0,8"/>
     <TextBlock Grid.Row="1" Grid.Column="2" Text="Prepared by" Foreground="{StaticResource TextMutedBrush}" Margin="0,8"/>
     <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding PreparedBy, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
     <TextBlock Grid.Row="2" Grid.Column="2" Text="Reviewer" Foreground="{StaticResource TextMutedBrush}" Margin="0,8"/>
     <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding ReviewerName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
     <TextBlock Grid.Row="3" Grid.Column="2" Text="Status" Foreground="{StaticResource TextMutedBrush}" Margin="0,8"/>
     <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding Status}" Foreground="White" Margin="0,8"/>
    </Grid>
   </Border>
   <Border Style="{StaticResource Card}">
    <TextBox Text="{Binding Rationale, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"/>
   </Border>
   <StackPanel Orientation="Horizontal">
    <Button Content="Calculate" Command="{Binding CalculateCommand}" Padding="16,9" Margin="0,0,8,0" Background="{StaticResource PrimaryBrandBrush}" Foreground="White"/>
    <Button Content="Save Plan" Command="{Binding SaveCommand}" Padding="16,9" Background="#1E293B" Foreground="White"/>
   </StackPanel>
   <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>