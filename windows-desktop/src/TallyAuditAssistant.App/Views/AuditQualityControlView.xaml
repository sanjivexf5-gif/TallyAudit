<UserControl x:Class="TallyAuditAssistant.App.Views.AuditQualityControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="Run Quality Control"
                    Command="{Binding RunChecksCommand}"
                    Background="{StaticResource PrimaryBrandBrush}"
                    Foreground="White" BorderThickness="0" Padding="16,9"/>
            <StackPanel>
                <TextBlock Text="Audit Quality Control" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding CompanyName}" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding FinancialYear}" Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>
        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,8">
            <Border Style="{StaticResource Card}">
                <StackPanel><TextBlock Text="PASSED" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding PassedChecks}" FontSize="24" FontWeight="Bold" Foreground="#22C55E"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel><TextBlock Text="WARNINGS" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding Warnings}" FontSize="24" FontWeight="Bold" Foreground="#F59E0B"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel><TextBlock Text="ATTENTION" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding AttentionRequired}" FontSize="24" FontWeight="Bold" Foreground="#F97316"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel><TextBlock Text="BLOCKED" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding Blocked}" FontSize="24" FontWeight="Bold" Foreground="#EF4444"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel><TextBlock Text="REVIEW" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding ReadyForReview}" FontSize="20" FontWeight="Bold" Foreground="White"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel><TextBlock Text="FINALIZATION" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding ReadyForFinalization}" FontSize="20" FontWeight="Bold" Foreground="White"/></StackPanel>
            </Border>
        </UniformGrid>

        <ListBox Grid.Row="2" ItemsSource="{Binding Checks}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Category}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding Severity}" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Status}" FontWeight="Bold" Foreground="White" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="{Binding Explanation}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding RecommendedAction}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="3" Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>