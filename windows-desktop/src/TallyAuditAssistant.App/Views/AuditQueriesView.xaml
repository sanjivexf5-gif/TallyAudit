<UserControl x:Class="TallyAuditAssistant.App.Views.AuditQueriesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="0,0,10,0">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="0,0,0,12">
   <TextBlock Text="Audit Query &amp; Follow-up Tracker" FontSize="22" FontWeight="Bold" Foreground="White"/>
   <TextBlock Text="Track management queries, responses and outstanding follow-ups without modifying TallyPrime." Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,8"/>
   <Border Padding="12,8" Background="#1E293B" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
    <StackPanel Orientation="Horizontal">
     <TextBlock Text="Company: " Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding ActiveCompanyName}" Foreground="#38BDF8" FontWeight="Bold"/>
     <TextBlock Text="   Total: " Foreground="{StaticResource TextMutedBrush}" Margin="18,0,0,0"/><TextBlock Text="{Binding TotalCount}" Foreground="White" FontWeight="Bold"/>
     <TextBlock Text="   Open: " Foreground="{StaticResource TextMutedBrush}" Margin="14,0,0,0"/><TextBlock Text="{Binding OpenCount}" Foreground="#F59E0B"/>
     <TextBlock Text="   Awaiting: " Foreground="{StaticResource TextMutedBrush}" Margin="14,0,0,0"/><TextBlock Text="{Binding AwaitingResponseCount}" Foreground="#38BDF8"/>
     <TextBlock Text="   Overdue: " Foreground="{StaticResource TextMutedBrush}" Margin="14,0,0,0"/><TextBlock Text="{Binding OverdueCount}" Foreground="#EF4444"/>
     <TextBlock Text="   Closed: " Foreground="{StaticResource TextMutedBrush}" Margin="14,0,0,0"/><TextBlock Text="{Binding ClosedCount}" Foreground="#10B981"/>
    </StackPanel>
   </Border>
  </StackPanel>
  <Border Grid.Row="1" Padding="10" Margin="0,0,0,12" Background="{StaticResource CardBackgroundBrush}" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox Grid.Column="0" Text="{Binding SearchQuery,UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="White" Padding="7" Margin="0,0,8,0"/>
    <ComboBox Grid.Column="1" SelectedValue="{Binding StatusFilter}" SelectedValuePath="Content" Margin="0,0,8,0" Background="#0F172A" Foreground="White"><ComboBoxItem Content="All"/><ComboBoxItem Content="Open"/><ComboBoxItem Content="Sent"/><ComboBoxItem Content="Response Received"/><ComboBoxItem Content="Under Review"/><ComboBoxItem Content="Closed"/><ComboBoxItem Content="Not Applicable"/></ComboBox>
    <ComboBox Grid.Column="2" SelectedValue="{Binding PriorityFilter}" SelectedValuePath="Content" Margin="0,0,8,0" Background="#0F172A" Foreground="White"><ComboBoxItem Content="All"/><ComboBoxItem Content="Low"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="High"/><ComboBoxItem Content="Critical"/></ComboBox>
    <Button Grid.Column="3" Content="🔄 Refresh" Command="{Binding LoadCommand}" Padding="10,6" Margin="0,0,8,0"/>
    <Button Grid.Column="4" Content="＋ New Query" Command="{Binding NewQueryCommand}" Padding="12,6"/>
   </Grid>
  </Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,10,0">
    <ListBox ItemsSource="{Binding Queries}" SelectedItem="{Binding SelectedQuery}" Background="Transparent" BorderThickness="0">
     <ListBox.ItemTemplate><DataTemplate><Border Padding="10" Margin="0,0,0,7" Background="#0F172A" CornerRadius="5" BorderBrush="#334155" BorderThickness="1"><StackPanel>
      <TextBlock Text="{Binding QueryNumber}" Foreground="#38BDF8" FontSize="11"/>
      <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Bold" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding AuditArea}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
      <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
     </StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </Border>
   <Border Grid.Column="1" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="Query Details" FontSize="17" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,8,8"><TextBlock Text="Query Number" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/><TextBox Text="{Binding QueryNumberInput,UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="White" Padding="7"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="8,0,0,8"><TextBlock Text="Title" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/><TextBox Text="{Binding TitleInput,UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="White" Padding="7"/></StackPanel>
     </Grid>
     <TextBlock Text="Details / Question" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/><TextBox Text="{Binding DetailsInput,UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="White" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Padding="7" Margin="0,3,0,10"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,6,8"><TextBlock Text="Audit Area" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/><ComboBox SelectedValue="{Binding AuditAreaInput}" SelectedValuePath="Content" Background="#0F172A" Foreground="White"><ComboBoxItem Content="General"/><ComboBoxItem Content="GST"/><ComboBoxItem Content="TDS"/><ComboBoxItem Content="Accounting"/><ComboBoxItem Content="Banking"/><ComboBoxItem Content="Ledger"/></ComboBox></StackPanel>
      <StackPanel Grid.Column="1" Margin="3,0,3,8"><TextBlock Text="Priority" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/><ComboBox SelectedValue="{Binding PriorityInput}" SelectedValuePath="Content" Background="#0F172A" Foreground="White"><ComboBoxItem Content="Low"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="High"/><ComboBoxItem Content="Critical"/></ComboBox></StackPanel>
      <StackPanel Grid.Column="2" Margin="6,0,0,8"><TextBlock Text="Status" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/><ComboBox SelectedValue="{Binding StatusInput}" SelectedValuePath="Content" Background="#0F172A" Foreground="White"><ComboBoxItem Content="Open"/><ComboBoxItem Content="Sent"/><ComboBoxItem Content="Response Received"/><ComboBoxItem Content="Under Review"/><ComboBoxItem Content="Closed"/><ComboBoxItem Content="Not Applicable"/></ComboBox></StackPanel>
     </Grid>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,6,8"><TextBlock Text="Responsible Person" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/><TextBox Text="{Binding ResponsiblePersonInput,UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="White" Padding="7"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="6,0,0,8"><TextBlock Text="Due Date" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/><DatePicker SelectedDate="{Binding DueDateInput}" Background="#0F172A" Foreground="White"/></StackPicker>
     </Grid>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,6,8"><TextBlock Text="Finding ID" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/><TextBox Text="{Binding FindingIdInput,UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="White" Padding="7"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="6,0,0,8"><TextBlock Text="Management Response" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/><TextBox Text="{Binding ManagementResponseInput,UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="White" Padding="7"/></StackPanel>
     </Grid>
     <TextBlock Text="Auditor Remarks" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/><TextBox Text="{Binding AuditorRemarksInput,UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="White" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Padding="7" Margin="0,3,0,10"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="{Binding StatusMessage}" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/><Button Content="💾 Save Query" Command="{Binding SaveCommand}" Padding="14,8"/></StackPanel>
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
 </Grid>
</UserControl>
