<UserControl x:Class="TallyAuditAssistant.App.Views.AuditReportPackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Audit Report Pack" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding ActiveCompanyName}" FontSize="15" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
            <TextBlock Text="Board-ready summary combining risk, findings, checklist, evidence and finalization." Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,16"/>
        </StackPanel>
        <Border Grid.Row="1" Padding="14" CornerRadius="8" Background="#111827" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,16">
            <WrapPanel>
                <StackPanel Margin="0,0,28,0"><TextBlock Text="Risk Score" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding RiskScore}" FontSize="24" FontWeight="Bold" Foreground="White"/><TextBlock Text="{Binding RiskLevel}" Foreground="#38BDF8"/></StackPanel>
                <StackPanel Margin="0,0,28,0"><TextBlock Text="Findings" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding TotalFindings}" FontSize="24" FontWeight="Bold" Foreground="White"/><TextBlock Text="{Binding PendingFindings, StringFormat={}{0} pending}" Foreground="{StaticResource TextMutedBrush}"/></StackPanel>
                <StackPanel Margin="0,0,28,0"><TextBlock Text="Checklist" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding ChecklistCompletion, StringFormat={}{0}%}" FontSize="24" FontWeight="Bold" Foreground="White"/><TextBlock Text="{Binding CompletedChecklist, StringFormat={}{0} completed}" Foreground="{StaticResource TextMutedBrush}"/></StackPanel>
                <StackPanel><TextBlock Text="Evidence" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding VerifiedEvidence, StringFormat={}{0} verified}" FontSize="24" FontWeight="Bold" Foreground="White"/><TextBlock Text="{Binding TotalEvidence, StringFormat={}{0} total}" Foreground="{StaticResource TextMutedBrush}"/></StackPanel>
            </WrapPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Padding="16" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Pack Contents" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding PackSections}">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6"/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="The generated report is a self-contained HTML working-paper summary that can be printed or saved as PDF from the browser." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="16" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Generate" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Creates a professional audit report pack using the currently selected company." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,16"/>
                    <Button Content="📦 Generate Audit Report Pack" Command="{Binding GeneratePackCommand}" Padding="14,10" Margin="0,0,0,8"/>
                    <Button Content="↻ Refresh Data" Command="{Binding LoadCommand}" Padding="14,10"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,18,0,0"/>
                    <Border Background="#0F172A" Padding="10" Margin="0,16,0,0" CornerRadius="6">
                        <TextBlock Text="Read-only policy: this feature only reads audit data and creates local report files. It never writes back to TallyPrime." Foreground="White" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
