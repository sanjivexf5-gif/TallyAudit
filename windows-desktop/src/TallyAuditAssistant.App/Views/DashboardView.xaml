<UserControl x:Class="TallyAuditAssistant.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="950">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,0">
            <!-- Header bar with Refresh button -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Auditor Executive Overview" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Continuous statutory audit monitoring and discrepancy detection for TallyPrime." Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="🔄 Refresh Data" Command="{Binding RefreshDashboardCommand}" Padding="16,8"/>
            </Grid>

            <!-- Key Metric Cards Row -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- GST Card -->
                <Border Grid.Column="0" Margin="0,0,10,0" Padding="16" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="GST EXCEPTIONS" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                        <TextBlock Text="{Binding GstExceptionsCount}" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,6,0,0"/>
                        <TextBlock Text="ITC &amp; POS mismatches" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- TDS Card -->
                <Border Grid.Column="1" Margin="5,0,5,0" Padding="16" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="TDS EXCEPTIONS" FontSize="11" FontWeight="Bold" Foreground="#F59E0B"/>
                        <TextBlock Text="{Binding TDSExceptionsCount}" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,6,0,0"/>
                        <TextBlock Text="194C/J threshold alerts" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Accounting Anomalies -->
                <Border Grid.Column="2" Margin="5,0,5,0" Padding="16" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="ACCOUNTING ISSUES" FontSize="11" FontWeight="Bold" Foreground="#EC4899"/>
                        <TextBlock Text="{Binding AccountingExceptionsCount}" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,6,0,0"/>
                        <TextBlock Text="Negative cash &amp; suspense" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- High Priority Card -->
                <Border Grid.Column="3" Margin="10,0,0,0" Padding="16" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="HIGH / CRITICAL" FontSize="11" FontWeight="Bold" Foreground="#EF4444"/>
                        <TextBlock Text="{Binding HighPriorityCount}" FontSize="28" FontWeight="Bold" Foreground="#EF4444" Margin="0,6,0,0"/>
                        <TextBlock Text="Requires urgent review" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Sync Info & Audit Completion Bar -->
            <Border Padding="16" Margin="0,0,0,20" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Audit Review Progress" FontWeight="SemiBold" FontSize="14" Foreground="White"/>
                        <ProgressBar Height="10" Value="{Binding AuditCompletionPercentage}" Maximum="100" Margin="0,8,16,0" Foreground="{StaticResource PrimaryBrandBrush}" Background="#0F172A"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding AuditCompletionPercentage, StringFormat={}{0}% Completed}" FontWeight="Bold" FontSize="16" Foreground="#10B981" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding TotalVouchersSynchronized, StringFormat={}{0:N0} Vouchers Analyzed}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Recent Exceptions Table -->
            <Border Padding="16" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Recently Flagged Audit Exceptions" FontWeight="Bold" FontSize="15" Foreground="White" Margin="0,0,0,12"/>
                    <DataGrid ItemsSource="{Binding RecentExceptions}" AutoGenerateColumns="False" IsReadOnly="True" 
                              Background="Transparent" RowBackground="#162032" AlternatingRowBackground="#1E293B"
                              BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                              Foreground="White" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Rule" Binding="{Binding RuleName}" Width="200"/>
                            <DataGridTextColumn Header="Entity Type" Binding="{Binding EntityType}" Width="90"/>
                            <DataGridTextColumn Header="Voucher / Ledger" Binding="{Binding VoucherNumber}" Width="140"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding FlaggedAmount, StringFormat={}{0:C2}}" Width="110"/>
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="100"/>
                            <DataGridTextColumn Header="Suggested Review" Binding="{Binding SuggestedCorrection}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
