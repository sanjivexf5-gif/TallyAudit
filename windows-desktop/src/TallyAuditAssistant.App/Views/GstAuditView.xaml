<UserControl x:Class="TallyAuditAssistant.App.Views.GstAuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="0,0,10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Automated GST Compliance Audit" FontSize="22" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Reconciles outward supply CGST/SGST/IGST rates, identifies blocked input tax credits (ITC), and flags mismatched GSTIN entries." Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,12"/>
            <Border Padding="12" Background="#1E293B" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Company: " FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding ActiveCompanyName}" FontWeight="Bold" Foreground="#38BDF8" Margin="4,0,16,0"/>
                        <TextBlock Text="Exceptions Found: " FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Exceptions.Count}" FontWeight="Bold" Foreground="White" Margin="4,0,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="🔄 Refresh Findings" Command="{Binding LoadGstExceptionsCommand}" Padding="10,4"/>
                </Grid>
            </Border>

            <Border Padding="12" Margin="0,10,0,0" Background="#172554" CornerRadius="6"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="GSTR-2B Purchase Reconciliation" FontSize="15" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Import the B2B invoice CSV exported from the GST portal. Match results are screening indicators, not an ITC eligibility decision."
                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,8"/>
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="From" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker SelectedDate="{Binding Gstr2BFromDate}" Width="130" Margin="0,0,12,0"/>
                        <TextBlock Text="To" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker SelectedDate="{Binding Gstr2BToDate}" Width="130" Margin="0,0,12,0"/>
                        <Button Content="Import GSTR-2B CSV &amp; Reconcile" Command="{Binding ImportGstr2BCsvCommand}"
                                Padding="12,5"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding Gstr2BSummary}" Foreground="#BFDBFE" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <DataGrid ItemsSource="{Binding Gstr2BItems}" Height="175" Margin="0,8,0,0"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="125"/>
                            <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="110"/>
                            <DataGridTextColumn Header="Supplier GSTIN" Binding="{Binding SupplierGstin}" Width="150"/>
                            <DataGridTextColumn Header="Tally Voucher" Binding="{Binding TallyVoucherNumber}" Width="110"/>
                            <DataGridTextColumn Header="Books Value" Binding="{Binding BooksValue, StringFormat={}{0:N2}}" Width="105"/>
                            <DataGridTextColumn Header="2B Value" Binding="{Binding PortalValue, StringFormat={}{0:N2}}" Width="105"/>
                            <DataGridTextColumn Header="Difference" Binding="{Binding Difference, StringFormat={}{0:N2}}" Width="100"/>
                            <DataGridTextColumn Header="Explanation" Binding="{Binding Explanation}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="ITC Risk Screening — auditor review required" FontWeight="Bold" Foreground="White" Margin="0,10,0,4"/>
                    <DataGrid ItemsSource="{Binding ItcRiskItems}" Height="135" Margin="0,0,0,0"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Risk" Binding="{Binding RiskLevel}" Width="85"/>
                            <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="105"/>
                            <DataGridTextColumn Header="Finding" Binding="{Binding Finding}" Width="*"/>
                            <DataGridTextColumn Header="Auditor action" Binding="{Binding AuditorAction}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Main Body Area -->
        <Grid Grid.Row="1">
            <!-- State 1: Loading Overlay -->
            <Border Background="#1E293B" CornerRadius="8" Padding="30" Panel.ZIndex="10" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⏳ Analyzing GST Transactions &amp; Mismatches..." FontSize="16" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <ProgressBar IsIndeterminate="True" Width="260" Height="6" Background="#0F172A" Foreground="{StaticResource PrimaryBrandBrush}" BorderThickness="0"/>
                </StackPanel>
            </Border>

            <!-- State 2: Data Available (Split View: Table + Details) -->
            <Grid Visibility="{Binding HasExceptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- GST Findings Table -->
                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Discovered Exceptions" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                            
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Exceptions}" SelectedItem="{Binding SelectedException}" GridLinesVisibility="None" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Rule" Binding="{Binding RuleName}" Width="*"/>
                                    <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="100"/>
                                    <DataGridTextColumn Header="Voucher No" Binding="{Binding VoucherNumber}" Width="100"/>
                                    <DataGridTextColumn Header="Amount" Binding="{Binding FlaggedAmount, StringFormat={}{0:C}}" Width="120"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Detailed Exception Panel -->
                <Border Grid.Column="1" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="Finding Review &amp; Remarks" FontWeight="Bold" Foreground="White" Margin="0,0,0,14"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,0" Visibility="{Binding SelectedException, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="RULE DESCRIPTION" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding SelectedException.RuleName}" FontWeight="Bold" Foreground="White" Margin="0,2,0,12" TextWrapping="Wrap"/>

                                <TextBlock Text="AUDIT FINDING EXPLANATION" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding SelectedException.SuggestedCorrection}" Foreground="White" Margin="0,2,0,12" TextWrapping="Wrap"/>

                                <TextBlock Text="FLAGGED TRANSACTION DETAILS" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                <UniformGrid Columns="2" Margin="0,0,0,12">
                                    <StackPanel Margin="0,0,4,6">
                                        <TextBlock Text="Voucher Number" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding SelectedException.VoucherNumber, TargetNullValue='—'}" FontWeight="SemiBold" Foreground="White"/>
                                    </StackPanel>
                                    <StackPanel Margin="4,0,0,6">
                                        <TextBlock Text="Voucher Date" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding SelectedException.VoucherDate, StringFormat={}{0:dd-MMM-yyyy}, TargetNullValue='—'}" FontWeight="SemiBold" Foreground="White"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,4,0">
                                        <TextBlock Text="Ledger / Party" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding SelectedException.LedgerName, TargetNullValue='—'}" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Margin="4,0,0,0">
                                        <TextBlock Text="Flagged Amount" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding SelectedException.FlaggedAmount, StringFormat={}{0:C}, TargetNullValue='—'}" FontWeight="SemiBold" Foreground="#10B981"/>
                                    </StackPanel>
                                </UniformGrid>

                                <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/>

                                <TextBlock Text="Review Notes &amp; Working Remarks" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding AuditorNoteInput, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource BorderBrush}" Height="80" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" Padding="6"/>
                                <TextBlock Text="{Binding StatusMessage}" Foreground="#10B981" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" Visibility="{Binding SelectedException, Converter={StaticResource NullToVisibilityConverter}}">
                            <Button Content="✓ Accept / Resolve" Command="{Binding MarkAsAcceptedCommand}" Margin="0,0,8,0" Padding="12,6"/>
                            <Button Content="👁 Mark Reviewed" Command="{Binding MarkAsReviewedCommand}" Padding="12,6"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- State 3: Empty State -->
            <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="40"
                    Visibility="{Binding HasExceptions, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="540">
                    <TextBlock Text="⚖️" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="No GST findings are available because synchronized accounting data has not yet been audited." 
                               FontSize="16" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10"/>
                    
                    <Border Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Active Audit Target: " Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ActiveCompanyName, TargetNullValue='No Active Company'}" Foreground="#38BDF8" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Run a comprehensive audit to evaluate tax rate consistency, outward supply classification, and ITC eligibility across all vouchers." 
                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="▶  Run Comprehensive Audit" Command="{Binding RunComprehensiveAuditCommand}" Padding="16,8" Margin="0,0,12,0"/>
                        <Button Content="🔄 Go to Synchronize" Command="{Binding GoToSyncCommand}" Background="#334155" Padding="16,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
