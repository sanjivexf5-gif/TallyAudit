<Window x:Class="TallyAuditAssistant.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TallyAuditAssistant.App.ViewModels"
        xmlns:views="clr-namespace:TallyAuditAssistant.App.Views"
        xmlns:converters="clr-namespace:TallyAuditAssistant.App.Converters"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="768" Width="1200"
        Icon="pack://application:,,,/Assets/TallyAuditAssistant.ico"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBackgroundBrush}">

    <Window.Resources>
        <converters:MultiEqualityToBoolConverter x:Key="MultiEqualityToBoolConverter" />

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TallyConnectionViewModel}">
            <views:TallyConnectionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SyncViewModel}">
            <views:SyncView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditAutomationViewModel}">
            <views:AuditAutomationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CompaniesViewModel}">
            <views:CompaniesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GstAuditViewModel}">
            <views:GstAuditView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TdsAuditViewModel}">
            <views:TdsAuditView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VouchersViewModel}">
            <views:VouchersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LedgersViewModel}">
            <views:LedgersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BankAuditViewModel}">
            <views:BankAuditView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExceptionsViewModel}">
            <views:ExceptionsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RiskDashboardViewModel}">
            <views:RiskDashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WorkingPapersViewModel}">
            <views:WorkingPapersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditChecklistViewModel}">
            <views:AuditChecklistView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditTrailViewModel}">
            <views:AuditTrailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ManagementRepresentationLetterViewModel}">
            <views:ManagementRepresentationLetterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditEvidenceViewModel}">
            <views:AuditEvidenceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditFinalizationViewModel}">
            <views:AuditFinalizationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditReportPackViewModel}">
            <views:AuditReportPackView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditQueriesViewModel}">
            <views:AuditQueriesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditQualityControlViewModel}">
            <views:AuditQualityControlView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditMaterialityViewModel}">
            <views:AuditMaterialityView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InvestigationViewModel}">
            <views:InvestigationView />
        </DataTemplate>
        <DataTemplate x:Key="InvestigationViewTemplate">
            <views:InvestigationView />
        </DataTemplate>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource MultiEqualityToBoolConverter}">
                            <Binding Path="DataContext.CurrentSection" RelativeSource="{RelativeSource AncestorType=Window}" />
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource PrimaryBrandBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Status Header / Tally Ribbon -->
            <RowDefinition Height="52" />
            <!-- Main Content with Navigation Sidebar -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header Ribbon -->
        <Border Grid.Row="0" Background="#090D16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource PrimaryBrandBrush}" Margin="0,0,10,0">
                        <TextBlock Text="T" FontWeight="Bold" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Tally Audit Assistant" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Border Margin="12,0,0,0" Padding="6,2" CornerRadius="4" Background="#1E293B" BorderBrush="#334155" BorderThickness="1">
                        <TextBlock Text="AUDITOR PRO" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                    </Border>
                </StackPanel>

                <!-- Active Company & FY -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Company: " Foreground="{StaticResource TextMutedBrush}" FontSize="13"/>
                    <TextBlock Text="{Binding ActiveCompany}" FontWeight="SemiBold" Foreground="White" FontSize="13" Margin="0,0,16,0"/>
                </StackPanel>

                <!-- Tally Connection Live Status Indicator -->
                <Border Grid.Column="2" Padding="10,5" CornerRadius="20" Background="#1E293B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="{Binding ConnectionBadgeColor}" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Body: Sidebar Navigation + Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar -->
            <Border Grid.Column="0" Background="#090D16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <!-- Keep the full navigation available on smaller windows by making the menu vertically scrollable. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              CanContentScroll="True">
                    <StackPanel Margin="8,12">
                    <Button Content="📊  Dashboard" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Tag="Dashboard"/>
                    <Button Content="⚡  Smart Automation" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Automation" Tag="Automation"/>
                    <Button Content="⚖️  GST Audit" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="GST" Tag="GST"/>
                    <Button Content="📑  TDS Audit" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="TDS" Tag="TDS"/>
                    <Button Content="📜  Vouchers" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Vouchers" Tag="Vouchers"/>
                    <Button Content="📖  Ledgers" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Ledgers" Tag="Ledgers"/>
                    <Button Content="🏦  Bank Audit" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Bank" Tag="Bank"/>
                    <Button Content="⚠️  Exceptions" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Exceptions" Tag="Exceptions"/>
                    <Button Content="🛡️  Risk Dashboard" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="RiskDashboard" Tag="RiskDashboard"/>
                    <Button Content="📈  Reports" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Reports" Tag="Reports"/>
                    <Button Content="📝  Working Papers" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="WorkingPapers" Tag="WorkingPapers"/>
                    <Button Content="☑️  Audit Checklist" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="AuditChecklist" Tag="AuditChecklist"/>
                    <Button Content="🛡️  Audit Trail" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="AuditTrail" Tag="AuditTrail"/>
                    <Button Content="✉️  Management Letter" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="ManagementLetter" Tag="ManagementLetter"/>
                    <Button Content="📎  Audit Evidence" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="AuditEvidence" Tag="AuditEvidence"/>
                    <Button Content="🔒  Finalize Audit" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="AuditFinalization" Tag="AuditFinalization"/>
                    <Button Content="📦  Audit Report Pack" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="AuditReportPack" Tag="AuditReportPack"/>
                    <Button Content="💬  Audit Queries" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="AuditQueries" Tag="AuditQueries"/>
                    <Button Content="🛡️  Quality Control" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="AuditQualityControl" Tag="AuditQualityControl"/>
                    <Button Content="📐  Materiality &amp; Sampling" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="AuditMateriality" Tag="AuditMateriality"/>
                    <Button Content="⚙️  Settings" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Settings" Tag="Settings"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Dynamic View Host -->
            <Border Grid.Column="1" Padding="20" Background="{StaticResource SurfaceBackgroundBrush}">
                <ContentControl Content="{Binding CurrentViewModel}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSection}" Value="Investigation">
                                    <Setter Property="ContentTemplate" Value="{StaticResource InvestigationViewTemplate}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Border>
        </Grid>
    </Grid>
</Window>
