<UserControl x:Class="TallyAuditAssistant.App.Views.PracticeClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,0,10,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="CA Practice — Clients &amp; Entities" FontSize="22" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Maintain practice clients separately from synchronized Tally companies. One client can have multiple legal entities and GST registrations." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
            <DockPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#38BDF8" VerticalAlignment="Center"/>
                <Button Content="Refresh" Command="{Binding LoadClientsCommand}" DockPanel.Dock="Right" Padding="14,5"/>
            </DockPanel>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Grid.Column="0" Grid.RowSpan="2" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Practice clients" Foreground="White" FontWeight="Bold" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Client" Binding="{Binding DisplayName}" Width="*"/>
                            <DataGridTextColumn Header="Code" Binding="{Binding ClientCode}" Width="95"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding ClientType}" Width="85"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Grid.Row="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Add practice client" Foreground="White" FontWeight="Bold" Margin="0,0,0,8"/>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,6"><TextBlock Text="Client code *" Foreground="{StaticResource TextMutedBrush}"/><TextBox Text="{Binding ClientCode, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Margin="8,0,0,6"><TextBlock Text="Client name *" Foreground="{StaticResource TextMutedBrush}"/><TextBox Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Margin="0,0,8,6"><TextBlock Text="Client type" Foreground="{StaticResource TextMutedBrush}"/><ComboBox SelectedValue="{Binding ClientType}" SelectedValuePath="Content"><ComboBoxItem Content="Business"/><ComboBoxItem Content="Company"/><ComboBoxItem Content="Individual"/><ComboBoxItem Content="LLP"/><ComboBoxItem Content="Trust"/></ComboBox></StackPanel>
                            <StackPanel Margin="8,0,0,6"><TextBlock Text="PAN" Foreground="{StaticResource TextMutedBrush}"/><TextBox Text="{Binding ClientPan, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Margin="0,0,8,6"><TextBlock Text="Email" Foreground="{StaticResource TextMutedBrush}"/><TextBox Text="{Binding ClientEmail, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Margin="8,0,0,6"><TextBlock Text="Phone" Foreground="{StaticResource TextMutedBrush}"/><TextBox Text="{Binding ClientPhone, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </UniformGrid>
                        <Button Content="Save client" Command="{Binding SaveClientCommand}" HorizontalAlignment="Right" Padding="18,6" Margin="0,4,0,0"/>
                        <Separator Margin="0,12"/>
                        <TextBlock Text="{Binding SelectedClient.DisplayName, StringFormat=Legal entities for {0}, TargetNullValue='Select a client'}" Foreground="White" FontWeight="Bold" Margin="0,0,0,6"/>
                        <DataGrid ItemsSource="{Binding Entities}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="105" HeadersVisibility="Column" GridLinesVisibility="None">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Legal name" Binding="{Binding LegalName}" Width="*"/>
                                <DataGridTextColumn Header="GSTIN" Binding="{Binding GSTIN}" Width="145"/>
                                <DataGridTextColumn Header="State" Binding="{Binding StateCode}" Width="55"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="1" Grid.Row="1" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel>
                    <TextBlock Text="Add legal entity / GST registration" Foreground="White" FontWeight="Bold" Margin="0,0,0,8"/>
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,8,6"><TextBlock Text="Legal name *" Foreground="{StaticResource TextMutedBrush}"/><TextBox Text="{Binding EntityLegalName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Margin="8,0,0,6"><TextBlock Text="Entity PAN" Foreground="{StaticResource TextMutedBrush}"/><TextBox Text="{Binding EntityPan, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="GSTIN" Foreground="{StaticResource TextMutedBrush}"/><TextBox Text="{Binding EntityGstin, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Margin="8,0,0,0"><TextBlock Text="State code" Foreground="{StaticResource TextMutedBrush}"/><TextBox Text="{Binding EntityStateCode, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    </UniformGrid>
                    <Button Content="Add entity to selected client" Command="{Binding SaveEntityCommand}" IsEnabled="{Binding HasSelectedClient}" HorizontalAlignment="Right" Padding="18,6" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>