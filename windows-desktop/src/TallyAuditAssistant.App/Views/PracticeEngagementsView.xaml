<UserControl x:Class="TallyAuditAssistant.App.Views.PracticeEngagementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,0,10,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="CA Practice — Engagement Management" FontSize="22" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Assign statutory and advisory work by client, legal entity and financial year. Track ownership, review, fees and due dates." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
            <DockPanel><TextBlock Text="{Binding StatusMessage}" Foreground="#38BDF8" VerticalAlignment="Center"/><Button Content="Refresh" Command="{Binding LoadCommand}" DockPanel.Dock="Right" Padding="14,5"/></DockPanel>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="New engagement" Foreground="White" FontWeight="Bold" Margin="0,0,0,8"/>
                    <UniformGrid Columns="4">
                        <StackPanel Margin="0,0,8,6"><TextBlock Text="Practice client *" Foreground="{StaticResource TextMutedBrush}"/><ComboBox ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}" DisplayMemberPath="DisplayName"/></StackPanel>
                        <StackPanel Margin="8,0,8,6"><TextBlock Text="Legal entity (optional)" Foreground="{StaticResource TextMutedBrush}"/><ComboBox ItemsSource="{Binding Entities}" SelectedItem="{Binding SelectedEntity}" DisplayMemberPath="LegalName"/></StackPanel>
                        <StackPanel Margin="8,0,8,6"><TextBlock Text="Service code *" Foreground="{StaticResource TextMutedBrush}"/><TextBox Text="{Binding ServiceCode, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Margin="8,0,0,6"><TextBlock Text="Service name *" Foreground="{StaticResource TextMutedBrush}"/><TextBox Text="{Binding ServiceName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Margin="0,0,8,6"><TextBlock Text="Financial year *" Foreground="{StaticResource TextMutedBrush}"/><TextBox Text="{Binding FinancialYear, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Margin="8,0,8,6"><TextBlock Text="Due date (DD-MM-YYYY)" Foreground="{StaticResource TextMutedBrush}"/><TextBox Text="{Binding DueDateText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Margin="8,0,8,6"><TextBlock Text="Professional fee (₹)" Foreground="{StaticResource TextMutedBrush}"/><TextBox Text="{Binding ProfessionalFeeText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Margin="8,0,0,6"><TextBlock Text="Initial status" Foreground="{StaticResource TextMutedBrush}"/><ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status}"/></StackPanel>
                        <StackPanel Margin="0,0,8,6"><TextBlock Text="Assigned staff" Foreground="{StaticResource TextMutedBrush}"/><ComboBox ItemsSource="{Binding ActiveUsers}" SelectedItem="{Binding AssignedUser}" DisplayMemberPath="DisplayName"/></StackPanel>
                        <StackPanel Margin="8,0,8,6"><TextBlock Text="Reviewer" Foreground="{StaticResource TextMutedBrush}"/><ComboBox ItemsSource="{Binding ActiveUsers}" SelectedItem="{Binding ReviewerUser}" DisplayMemberPath="DisplayName"/></StackPanel>
                        <StackPanel Grid.ColumnSpan="2" Margin="8,0,0,6"><TextBlock Text="Notes" Foreground="{StaticResource TextMutedBrush}"/><TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    </UniformGrid>
                    <Button Content="Create engagement" Command="{Binding SaveEngagementCommand}" HorizontalAlignment="Right" Padding="18,6" Margin="0,4,0,0" IsEnabled="{Binding HasSelectedClient}"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Engagement register" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <TextBlock Text="Update selected status:" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Width="145" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status}"/>
                            <Button Content="Apply" Command="{Binding UpdateSelectedStatusCommand}" Margin="8,0,0,0" Padding="14,4"/>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Engagements}" SelectedItem="{Binding SelectedEngagement}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="2*"/>
                            <DataGridTextColumn Header="FY" Binding="{Binding FinancialYear}" Width="75"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="115"/>
                            <DataGridTextColumn Header="Due date" Binding="{Binding DueDate, StringFormat=dd-MMM-yyyy}" Width="105"/>
                            <DataGridTextColumn Header="Fee (₹)" Binding="{Binding ProfessionalFee, StringFormat=N2}" Width="100"/>
                            <DataGridTextColumn Header="Assigned user ID" Binding="{Binding AssignedToUserId}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>