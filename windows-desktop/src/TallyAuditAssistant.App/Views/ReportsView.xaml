<UserControl x:Class="TallyAuditAssistant.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="900">
    <Grid Margin="0,0,10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Audit Working Papers &amp; Reports Center" FontSize="22" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Generate, compile, and export professional statutory audit summaries, tax reconciliations, and structured spreadsheets." Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,10"/>

            <!-- Company Overview Ribbon -->
            <Border Padding="14,10" Background="#1E293B" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Company: " FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding ActiveCompanyName, TargetNullValue='No Active Company'}" FontWeight="Bold" Foreground="#38BDF8" Margin="4,0,20,0"/>

                        <TextBlock Text="Transactions: " FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding TotalVouchersCount, StringFormat={}{0:N0}}" FontWeight="Bold" Foreground="White" Margin="4,0,20,0"/>

                        <TextBlock Text="Audit Exceptions: " FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding TotalExceptionsCount}" FontWeight="Bold" Foreground="#F59E0B" Margin="4,0,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="📁 Open Export Folder" Command="{Binding OpenFolderCommand}" Background="#334155" Padding="12,5" FontSize="11"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Feedback & Status Notification Banner -->
        <Border Grid.Row="1" Margin="0,0,0,14" CornerRadius="6" Padding="12,10"
                Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                            <Setter Property="Background" Value="#064E3B"/>
                            <Setter Property="BorderBrush" Value="#059669"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Background" Value="#7F1D1D"/>
                            <Setter Property="BorderBrush" Value="#DC2626"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ℹ️ " VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding HasExportedFile, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Content="📂 Open File" Command="{Binding OpenFileCommand}" Padding="10,4" Margin="0,0,8,0" FontSize="11"/>
                    <Button Content="📁 Show in Folder" Command="{Binding OpenFolderCommand}" Background="#334155" Padding="10,4" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <!-- Loading Indicator -->
            <Border Background="#1E293B" CornerRadius="8" Padding="30" Panel.ZIndex="10" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⏳ Generating and formatting export artifact..." FontSize="16" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <ProgressBar IsIndeterminate="True" Width="260" Height="6" Background="#0F172A" Foreground="{StaticResource PrimaryBrandBrush}" BorderThickness="0"/>
                </StackPanel>
            </Border>

            <!-- Active Reports Panel (when data exists) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
                <UniformGrid Columns="3" VerticalAlignment="Top">
                    <!-- Excel Export Card -->
                    <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18" Margin="0,0,10,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="📊 Microsoft Excel" FontSize="17" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="1" Text="Full Working Papers Package" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBlock Grid.Row="2" Text="Generates an XML spreadsheet with individual tabs for All Exceptions, GST Discrepancies, TDS Variances, Accounting Hygiene, and Executive Metadata." 
                                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                            <Button Grid.Row="3" Content="📥 Export Excel Papers" Command="{Binding GenerateExcelReportCommand}" HorizontalAlignment="Stretch" Padding="12,10"/>
                        </Grid>
                    </Border>

                    <!-- HTML Summary Card -->
                    <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18" Margin="5,0,5,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="📄 Executive HTML" FontSize="17" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="1" Text="Print-Ready Audit Summary" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBlock Grid.Row="2" Text="Produces a polished, stand-alone HTML audit document with high-level KPI cards, company registration details, and structured statutory review notes." 
                                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                            <Button Grid.Row="3" Content="📥 Generate HTML Summary" Command="{Binding GeneratePdfReportCommand}" HorizontalAlignment="Stretch" Padding="12,10"/>
                        </Grid>
                    </Border>

                    <!-- CSV Export Card -->
                    <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18" Margin="10,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="📑 Universal CSV" FontSize="17" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="1" Text="Raw Data Register" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBlock Grid.Row="2" Text="Exports all flagged exception rows into a clean, comma-delimited CSV file compatible with external audit workpapers, SQL tools, and custom BI sheets." 
                                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                            <Button Grid.Row="3" Content="📥 Export CSV Register" Command="{Binding GenerateCsvReportCommand}" HorizontalAlignment="Stretch" Padding="12,10"/>
                        </Grid>
                    </Border>
                </UniformGrid>
            </ScrollViewer>

            <!-- Empty State (When no company or no audit has been run) -->
            <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="40"
                    Visibility="{Binding HasData, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="540">
                    <TextBlock Text="📈" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="No audit reports available for export." 
                               FontSize="16" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10"/>
                    
                    <Border Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Company: " Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ActiveCompanyName, TargetNullValue='No Active Company'}" Foreground="#38BDF8" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Synchronize your vouchers from TallyPrime and run a comprehensive audit to generate professional working papers and executive summaries." 
                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="▶  Run Comprehensive Audit" Command="{Binding GoToAuditCommand}" Padding="16,8" Margin="0,0,12,0"/>
                        <Button Content="🔄 Go to Synchronize" Command="{Binding GoToSyncCommand}" Background="#334155" Padding="16,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
