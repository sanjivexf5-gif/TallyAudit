{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/tally_audit_assistant_.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "AuditSettings": {
    "DatabaseFileName": "audit_assistant_data.db",
    "DefaultTallyHost": "localhost",
    "DefaultTallyPort": 9000,
    "ScanPortRangeStart": 9000,
    "ScanPortRangeEnd": 9005,
    "UseMockTally": false,
    "AutoCheckConnection": true,
    "AutoCheckIntervalSeconds": 15
  }
}
